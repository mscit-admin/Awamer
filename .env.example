# =====================================================================
# NetSphere Terminal — .env.example  (Node.js backend)
# =====================================================================
# Copy this to .env. Do NOT commit .env.

# --- Application -----------------------------------------------------
APP_ENV=development
APP_NAME=netsphere
LOG_LEVEL=info

# --- HTTP ------------------------------------------------------------
AUTH_HTTP_HOST=0.0.0.0
AUTH_HTTP_PORT=8081

# --- PostgreSQL ------------------------------------------------------
DATABASE_URL=postgres://netsphere:netsphere_dev@localhost:5433/netsphere
DATABASE_MAX_CONNS=25

POSTGRES_DB=netsphere
POSTGRES_USER=netsphere
POSTGRES_PASSWORD=netsphere_dev
# Host-side published port; container always exposes 5432 internally.
POSTGRES_HOST_PORT=5433

# --- Redis -----------------------------------------------------------
REDIS_PASSWORD=netsphere_dev
REDIS_HOST_PORT=6379

# --- JWT -------------------------------------------------------------
# In production, generate with: openssl rand -base64 64
JWT_ACCESS_SECRET=dev-only-change-me-access-secret-must-be-at-least-32-chars
JWT_REFRESH_SECRET=dev-only-change-me-refresh-secret-must-be-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
JWT_ISSUER=netsphere

# --- Credential encryption (Phase 10) -------------------------------
# AES-256-GCM key for encrypting credential secrets at rest.
# 32 bytes, base64 or hex. Generate with: openssl rand -base64 32
# REQUIRED in production. If left unset in development the key is derived
# from JWT_REFRESH_SECRET (a warning is logged); set a dedicated key here
# before going to production — rotating JWT_REFRESH_SECRET would otherwise
# make existing encrypted credentials unreadable.
# CREDENTIAL_ENCRYPTION_KEY=

# --- Argon2id --------------------------------------------------------
ARGON2_MEMORY_KB=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=4

# --- Limits ----------------------------------------------------------
RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_API_PER_MIN=120
ACCOUNT_LOCKOUT_THRESHOLD=5

# --- CORS ------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:1420,tauri://localhost,https://tauri.localhost

# --- Bootstrap admin (auto-created on first start) -------------------
# IMPORTANT: change the password after first login.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe!2026
BOOTSTRAP_ADMIN_EMAIL=admin@netsphere.local

# --- Desktop (Vite) --------------------------------------------------
VITE_API_BASE_URL=http://localhost:8081
VITE_APP_NAME=NetSphere Terminal
