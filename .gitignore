# =====================================================================
# NetSphere Terminal — .gitignore
# =====================================================================

# Never commit production secrets
.env
.env.production
.env.local
.env.*.local
!.env.production.example
!.env.example

# Database backups (dumps only — NOT schema migrations)
backups/
*.sql.gz
*.sql
# Keep schema migrations under version control. The broad *.sql rule
# above previously swallowed these, so they were never committed.
!backend/migrations/
!backend/migrations/*.sql

# Dependency directories
node_modules/
desktop/src-tauri/target/

# Build output
dist/
build/

# Editor / OS junk
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*~

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# Docker
.docker-cache/
