# =====================================================================
# NetSphere Terminal — .gitignore
# =====================================================================

# Never commit production secrets
.env
.env.production
.env.local
.env.*.local
!.env.production.example
!.env.example

# Database backups
backups/
*.sql.gz
*.sql

# Dependency directories
node_modules/
desktop/src-tauri/target/

# Build output
dist/
build/

# Editor / OS junk
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*~

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# Docker
.docker-cache/
