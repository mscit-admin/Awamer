# =====================================================================
# NetSphere Terminal — .gitignore
# =====================================================================

# Never commit production secrets
.env
.env.production
.env.local
.env.*.local
!.env.production.example
!.env.example

# Database backups (dumps only — NOT schema migrations)
backups/
*.sql.gz
*.sql
# Keep schema migrations under version control. The broad *.sql rule
# above previously swallowed these, so they were never committed.
!backend/migrations/
!backend/migrations/*.sql

# Dependency directories
node_modules/
desktop/src-tauri/target/
desktop/src-tauri/gen/

# Build output
dist/
build/

# Editor / OS junk
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*~

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# Docker
.docker-cache/

# Installation evidence (generated at install time; may contain host details).
# The production location is /var/log/awamer/installation; this covers the
# in-repo fallback and any generated support bundles.
installation-evidence/
awamer-installation-*.tar.gz
