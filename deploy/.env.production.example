# =====================================================================
# NetSphere Terminal — Production environment
# =====================================================================
#
# Copy this file to ../.env.production (NOT into version control!) and
# fill in real values. Compose will refuse to start if any required
# variable is missing, so you can't accidentally ship a default secret.
#
# Generate strong secrets:
#
#   JWT_ACCESS_SECRET          openssl rand -hex 64
#   JWT_REFRESH_SECRET         openssl rand -hex 64
#   CREDENTIAL_ENCRYPTION_KEY  openssl rand -base64 32   # 32 bytes (base64 or hex)
#   POSTGRES_PASSWORD          openssl rand -base64 32
#   REDIS_PASSWORD             openssl rand -base64 32
#   BOOTSTRAP_ADMIN_PASS       any strong password — change immediately after first login
#
# OR run: ./scripts/generate-secrets.sh
#
# NOTE: variable names below match backend/src/config/index.ts exactly.
# =====================================================================

# ----- Database -------------------------------------------------------
POSTGRES_USER=netsphere
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_DB=netsphere

# ----- Redis ----------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME_redis_password

# ----- Crypto secrets (ROTATING THESE WILL INVALIDATE ALL SESSIONS) ---
JWT_ACCESS_SECRET=CHANGE_ME_64_byte_hex_string
JWT_REFRESH_SECRET=CHANGE_ME_different_64_byte_hex_string

# ----- Credential encryption (Phase 10) -------------------------------
# Encrypts credential secrets at rest (AES-256-GCM). 32 bytes, base64 or hex.
# REQUIRED in production. Rotating it makes existing encrypted credentials
# unreadable — back it up alongside the JWT secrets.
CREDENTIAL_ENCRYPTION_KEY=CHANGE_ME_32_byte_base64_key

# ----- SEC-INFRA-001: VPN helper IPC secret ---------------------------
# Authenticates backend → awamer-vpn-helper requests over the shared Unix
# socket. REQUIRED. High-entropy (>=32 chars): openssl rand -hex 32
VPN_HELPER_SECRET=CHANGE_ME_32_byte_hex_string

# ----- Bootstrap admin (used only on first server start) --------------
# After the first login, you can disable this user via the admin UI
# and create real accounts. Choose a strong password.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_strong_admin_password
BOOTSTRAP_ADMIN_EMAIL=admin@netsphere.local

# ----- CORS (which origins may call the API from a browser) -----------
# For Tauri desktop clients add tauri://localhost and https://tauri.localhost.
# For a web frontend (e.g. https://netsphere.example.com) add it here.
# Comma-separated, no spaces.
CORS_ALLOWED_ORIGINS=https://netsphere.example.com,tauri://localhost,https://tauri.localhost

# ----- Logging --------------------------------------------------------
LOG_LEVEL=info

# ----- Rate limiting --------------------------------------------------
RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_API_PER_MIN=120

# ----- Application version (image tag) --------------------------------
APP_VERSION=1.8.0

# SEC-RESET-001: trusted public base URL for password-reset links (set by installer).
# e.g. https://awamer.example.com or https://awamer.example.com:6655
APP_PUBLIC_BASE_URL=
