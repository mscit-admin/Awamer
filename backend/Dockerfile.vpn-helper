# =====================================================
# awamer-vpn-helper (SEC-INFRA-001) — the ONLY privileged component.
#
# A minimal service whose sole job is the privileged OpenVPN lifecycle. It runs
# in its own container with NET_ADMIN + /dev/net/tun and NO public port; the
# unprivileged backend reaches it only over an authenticated Unix socket. It is
# the ONLY image that contains and executes the openvpn binary.
# =====================================================
FROM node:20-alpine AS builder

RUN apk add --no-cache python3 make g++
WORKDIR /src
# SEC-RELEASE-001: install EXACTLY the audited lockfile (reproducible build;
# a plain `npm install` would re-resolve ^ranges at build time).
COPY package.json package-lock.json ./
# GO-LIVE traceability: the image tag (APP_VERSION) must equal package.json.
ARG APP_VERSION=""
RUN if [ -n "$APP_VERSION" ] && [ "$APP_VERSION" != "$(node -p "require('./package.json').version")" ]; then \
      echo "APP_VERSION=$APP_VERSION does not match package.json $(node -p "require('./package.json').version")" >&2; exit 1; \
    fi
COPY tsconfig.json ./
RUN npm ci --no-audit --no-fund
COPY src ./src
RUN npm run build
RUN npm prune --omit=dev

# =====================================================
FROM node:20-alpine

# Release identity (non-sensitive): exposed by GET /api/v1/version and OCI labels.
ARG APP_VERSION=""
ARG GIT_COMMIT=unknown
ARG BUILD_DATE=unknown
LABEL org.opencontainers.image.title="awamer" \
      org.opencontainers.image.version="${APP_VERSION}" \
      org.opencontainers.image.revision="${GIT_COMMIT}" \
      org.opencontainers.image.created="${BUILD_DATE}"
ENV GIT_COMMIT=${GIT_COMMIT} \
    BUILD_DATE=${BUILD_DATE}

# openvpn + iproute2 (openvpn shells out to `ip` to configure the tun interface).
# tini reaps the openvpn children. No setuid bit is needed: this container holds
# NET_ADMIN and the main process runs as root INSIDE this confined container —
# which is the whole point of the split (root+NET_ADMIN live here, not in the API).
#
# MULTI-VPN-FW-001 — `iptables` is REQUIRED, not optional: the helper opens/closes
# each VPN Server's host firewall rule itself (structured args, no shell). It must
# be installed explicitly in THIS image; the helper never relies on the host having
# iptables, and there is no transitive/implicit dependency to fall back on.
RUN apk add --no-cache tini openvpn iproute2 iptables

WORKDIR /app
COPY --from=builder /src/node_modules ./node_modules
COPY --from=builder /src/dist ./dist
COPY package.json ./

ENV NODE_ENV=production \
    OPENVPN_PATH=/usr/sbin/openvpn \
    VPN_HELPER_SOCKET=/run/awamer/vpn-helper.sock \
    VPN_RUNTIME_DIR=/var/lib/awamer/vpn-runtime

# No EXPOSE / no ports — this service is never reachable over the network.
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "--enable-source-maps", "dist/vpn-helper/main.js"]
